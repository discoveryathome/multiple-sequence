(version 1)
(allow default)
(deny network*)
(deny file-write*)
(deny file-read* (subpath "/Users/colkitt"))
(allow file-read* file-write* (subpath "/Users/colkitt/discover-work/incubatedPilots/multiple-sequence"))
(allow file-write* (literal "/dev/null") (subpath "/private/tmp"))
(allow file-read-metadata (literal "/Users/colkitt") (literal "/Users/colkitt/discover-work") (literal "/Users/colkitt/discover-work/incubatedPilots"))
(allow file-write* (literal "/dev/stderr") (literal "/dev/stdout") (subpath "/dev/fd"))
(deny file-read* (subpath "/Users/colkitt/discover-work/incubatedPilots/multiple-sequence/contributor-trial/repo/data/references"))
(deny file-read* (subpath "/Users/colkitt/discover-work/incubatedPilots/multiple-sequence/contributor-trial/repo/data/source"))
